{
  "id": "cda-kcfn-inspection--officer-review-form",
  "title": "CDA Container Inspection & Recommendation",
  "schema": {
    "type": "object",
    "properties": {
      "review_outcome": {
        "type": "string",
        "title": "Inspection Outcome",
        "oneOf": [
          {
            "const": "approve",
            "title": "Accept"
          },
          {
            "const": "needs_more_info",
            "title": "Request Changes"
          }
        ],
        "example": "approve"
      },
      "inspection_notes": {
        "type": "string",
        "title": "Inspection Notes",
        "example": "Container contents match the declared quantity and product type."
      },
      "recommendation_fee_amount": {
        "type": "number",
        "title": "Application Recommendation Fee (LKR)",
        "description": "The amount the applicant will be asked to pay for the recommendation report.",
        "exclusiveMinimum": 0,
        "multipleOf": 0.01,
        "example": 1500
      },
      "rejection_reason": {
        "type": "string",
        "title": "Comments / Deficiencies (Required if Requesting Changes)",
        "example": "Declared quantity does not match the physically inspected container load."
      }
    },
    "required": [
      "review_outcome"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "review_outcome": {
              "const": "approve"
            }
          },
          "required": [
            "review_outcome"
          ]
        },
        "then": {
          "required": [
            "recommendation_fee_amount"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "review_outcome": {
              "const": "needs_more_info"
            }
          },
          "required": [
            "review_outcome"
          ]
        },
        "then": {
          "required": [
            "rejection_reason"
          ]
        }
      }
    ]
  },
  "uiSchema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Control",
        "scope": "#/properties/review_outcome"
      },
      {
        "type": "Control",
        "scope": "#/properties/inspection_notes",
        "options": {
          "multiLine": true
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/recommendation_fee_amount",
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/review_outcome",
            "schema": {
              "const": "approve"
            }
          }
        }
      },
      {
        "type": "Control",
        "scope": "#/properties/rejection_reason",
        "options": {
          "multiLine": true
        },
        "rule": {
          "effect": "SHOW",
          "condition": {
            "scope": "#/properties/review_outcome",
            "schema": {
              "const": "needs_more_info"
            }
          }
        }
      }
    ]
  }
}
